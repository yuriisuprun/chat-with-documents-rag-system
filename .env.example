# ============================================================================
# Chat With Documents – Configuration Template
# Copy to .env and fill in your values
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
# Execution environment: "development", "testing", or "production"
ENVIRONMENT=development

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Streamlit)
FRONTEND_PORT=8501

# Enable debug mode (development only)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# File Upload Settings
# ============================================================================
# Maximum file size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# Maximum PDF pages per document
MAX_PDF_PAGES=100

# Temporary upload directory
UPLOAD_DIR=./data/uploads

# ============================================================================
# PDF Processing Settings
# ============================================================================
# Enable text extraction from PDFs
PDF_EXTRACT_TEXT=true

# OCR disabled in MVP (would require tesseract)
PDF_EXTRACT_OCR=false

# ============================================================================
# Chunking Settings
# ============================================================================
# Character size for text chunks
CHUNK_SIZE=800

# Overlap between chunks
CHUNK_OVERLAP=120

# ============================================================================
# Embeddings Settings
# ============================================================================
# Embedding model to use
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Device for embeddings: "cpu" or "cuda"
EMBEDDING_DEVICE=cpu

# Normalize embeddings
EMBEDDING_NORMALIZE=true

# ============================================================================
# Vector Store Settings
# ============================================================================
# ChromaDB persist directory
CHROMADB_PERSIST_DIR=./data/chroma

# Collection name in ChromaDB
CHROMADB_COLLECTION_NAME=documents

# ============================================================================
# LLM Settings
# ============================================================================
# LLM provider: "ollama" or "openai"
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_TIMEOUT=120

# OpenAI settings (optional, not required for free MVP)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3

# ============================================================================
# Retrieval Settings
# ============================================================================
# Number of top chunks to retrieve
RETRIEVAL_TOP_K=4

# Similarity threshold (0.0 to 1.0, optional)
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# ============================================================================
# Database Settings
# ============================================================================
# SQLite database path
DATABASE_URL=sqlite:///./data/app.db

# ============================================================================
# Security Settings
# ============================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# API key authentication (Phase 8)
# Enable: true to require API key, false to disable (default)
API_KEY_ENABLED=false
API_KEY=your-secure-api-key-here

# Rate limiting (Phase 8)
# Enable: true to enforce rate limits, false to disable (default: true)
RATE_LIMIT_ENABLED=true

# Global requests per minute (default: 100)
RATE_LIMIT_GLOBAL=100

# Document upload requests per minute (default: 10)
RATE_LIMIT_UPLOAD=10

# Chat requests per minute (default: 30)
RATE_LIMIT_CHAT=30

# Input validation (Phase 8)
# Maximum query length in characters (default: 500)
MAX_QUERY_LENGTH=500

# Maximum document ID length (default: 36 for UUID)
MAX_DOCUMENT_ID_LENGTH=36

# Security headers (Phase 8)
# Enable security headers: true to add headers, false to disable (default: true)
ENABLE_SECURITY_HEADERS=true

# HSTS (HTTP Strict-Transport-Security): only enable in production
ENABLE_HSTS=false

# ============================================================================
# RAG Settings
# ============================================================================
# Check if context is sufficient before answering
RAG_CHECK_SUFFICIENCY=true

# Maximum tokens in context for retrieval
RAG_MAX_CONTEXT_TOKENS=2000

# ============================================================================
# Logging Settings
# ============================================================================
# Enable structured JSON logging
LOG_JSON=false

# ============================================================================
# Development Only
# ============================================================================
# Reload server on code changes (development only)
RELOAD=true

# Bypass embeddings for testing (creates dummy embeddings)
TEST_MODE=false
