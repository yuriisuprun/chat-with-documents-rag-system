# Database
DATABASE_URL=postgresql://assistant_user:assistant_password@db:5432/whatsapp_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_change_me

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
JWT_SECRET=your_jwt_secret_change_me_with_random_string

# App
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# AI Settings
MODEL_NAME=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_LENGTH=2000

# ============================================
# SINGLE TENANT CONFIGURATION
# Edit these to configure your service
# ============================================

# Professional/Business Information
TENANT_BUSINESS_NAME=My Professional Services
TENANT_PROFESSIONAL_NAME=John Doe
TENANT_WHATSAPP_NUMBER=+1234567890

# Auto Reply Settings
TENANT_AUTO_REPLY_DELAY_MINUTES=30

# Booking & Information (Language-Specific)
# Note: For auto-appointment, use Google Calendar (TENANT_APPOINTMENT_API_TYPE=google_calendar)
TENANT_BOOKING_URL=https://example.com/booking
TENANT_OFFICE_HOURS_EN=Mon-Fri: 9:00-17:00 CET
TENANT_OFFICE_HOURS_RU=Пн-Пт: 9:00-17:00 CET
TENANT_OFFICE_HOURS_IT=Lun-Ven: 9:00-17:00 CET

# Legal Compliance (Language-Specific)
TENANT_DISCLAIMER_EN=This is an automated assistant. This message is not professional advice.
TENANT_DISCLAIMER_RU=Это автоматический помощник. Это сообщение не является профессиональной консультацией.
TENANT_DISCLAIMER_IT=Questo è un assistente automatico. Questo messaggio non è una consulenza professionale.

# ============================================
# MULTI-LANGUAGE SUPPORT (Optional Configuration)
# ============================================
# Supported languages (comma-separated ISO 639-1 codes)
# Default: en,ru,it (English, Russian, Italian)
# The system automatically detects message language and responds in that language
SUPPORTED_LANGUAGES=en,ru,it

# Default language when detection fails
TENANT_DEFAULT_LANGUAGE=en

# ============================================
# APPOINTMENT AUTOMATION - GOOGLE CALENDAR (RECOMMENDED)
# ============================================
# Enable automatic appointment scheduling when client requests appointment
TENANT_ENABLE_AUTO_APPOINTMENT=false

# Calendar Integration Type
# Recommended: google_calendar
# Options: google_calendar, custom
TENANT_APPOINTMENT_API_TYPE=google_calendar

# Google Calendar Service Account Credentials (JSON format)
# Required when TENANT_ENABLE_AUTO_APPOINTMENT=true and using google_calendar
# Get credentials: https://console.cloud.google.com → APIs & Services → Credentials
# See GOOGLE_CALENDAR_SETUP.md for detailed setup instructions
TENANT_APPOINTMENT_API_KEY={"type":"service_account","project_id":"your_project_id","private_key":"","client_email":""}

# Custom API Endpoint (only for api_type="custom")
TENANT_APPOINTMENT_API_URL=

# Appointment Settings
TENANT_APPOINTMENT_DEFAULT_DURATION=30
TENANT_APPOINTMENT_WORKING_HOURS_START=9
TENANT_APPOINTMENT_WORKING_HOURS_END=17

# Custom confirmation message (optional)
TENANT_APPOINTMENT_CONFIRMATION_MESSAGE=
