# Database
DATABASE_URL=postgresql://assistant_user:assistant_password@db:5432/whatsapp_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_change_me

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
JWT_SECRET=your_jwt_secret_change_me_with_random_string

# App
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# AI Settings
MODEL_NAME=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_LENGTH=2000

# ============================================
# SINGLE TENANT CONFIGURATION
# Edit these to configure your service
# ============================================

# Professional/Business Information
TENANT_BUSINESS_NAME=Legal Services
TENANT_PROFESSIONAL_NAME=Your Name
TENANT_WHATSAPP_NUMBER=+1234567890

# Auto Reply Settings
TENANT_AUTO_REPLY_DELAY_MINUTES=30

# Booking & Information (Language-Specific)
# Note: For auto-appointment, use Google Calendar (TENANT_APPOINTMENT_API_TYPE=google_calendar)
TENANT_BOOKING_URL=https://calendar.google.com
TENANT_OFFICE_HOURS_EN=Mon-Fri: 9:00 AM - 5:00 PM, Sat: 10:00 AM - 2:00 PM (UTC)
TENANT_OFFICE_HOURS_RU=Пн-Пт: 9:00 - 17:00, Сб: 10:00 - 14:00 (UTC)
TENANT_OFFICE_HOURS_IT=Lun-Ven: 9:00 - 17:00, Sab: 10:00 - 14:00 (UTC)

# Legal Compliance (Language-Specific)
TENANT_DISCLAIMER_EN=This is an automated assistant. This message is not professional legal advice. Please consult with your attorney for legal matters. Services: Initial consultation (free), Document review ($150/hr), Legal drafting ($250/hr).
TENANT_DISCLAIMER_RU=Это автоматический помощник. Это сообщение не является профессиональной юридической консультацией. Пожалуйста, проконсультируйтесь с адвокатом по юридическим вопросам. Услуги: Первичная консультация (бесплатно), Проверка документов ($150/ч), Юридическое оформление ($250/ч).
TENANT_DISCLAIMER_IT=Questo è un assistente automatico. Questo messaggio non è una consulenza legale professionale. Si prega di consultare un avvocato per questioni legali. Servizi: Consulenza iniziale (gratuita), Revisione documenti ($150/ora), Stesura legale ($250/ora).

# ============================================
# MULTI-LANGUAGE SUPPORT (Optional Configuration)
# ============================================
# Supported languages (comma-separated ISO 639-1 codes)
# Default: en,ru,it (English, Russian, Italian)
# The system automatically detects message language and responds in that language
SUPPORTED_LANGUAGES=en,ru,it

# Default language when detection fails
TENANT_DEFAULT_LANGUAGE=en

# ============================================
# APPOINTMENT AUTOMATION - GOOGLE CALENDAR (RECOMMENDED)
# ============================================
# Enable automatic appointment scheduling when client requests appointment
TENANT_ENABLE_AUTO_APPOINTMENT=true

# Calendar Integration Type
# Recommended: google_calendar
# Options: google_calendar, custom
TENANT_APPOINTMENT_API_TYPE=google_calendar

# Google Calendar Service Account Credentials (JSON format)
# Required when TENANT_ENABLE_AUTO_APPOINTMENT=true and using google_calendar
# Get credentials: https://console.cloud.google.com → APIs & Services → Credentials
# See CALENDLY_TO_GOOGLE_CALENDAR_MIGRATION.md for detailed setup instructions
# Paste your entire service account JSON credentials here (must be valid JSON on one line)
TENANT_APPOINTMENT_API_KEY={"type":"service_account","project_id":"your_project_id","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"whatsapp-calendar@your-project-id.iam.gserviceaccount.com","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# Custom API Endpoint (only for api_type="custom")
TENANT_APPOINTMENT_API_URL=

# Appointment Settings
# Duration in minutes (your consultations are typically 60 minutes)
TENANT_APPOINTMENT_DEFAULT_DURATION=60

# Working hours for automatic scheduling (24-hour format)
# 9 AM - 5 PM (matches your office hours)
TENANT_APPOINTMENT_WORKING_HOURS_START=9
TENANT_APPOINTMENT_WORKING_HOURS_END=17

# Custom confirmation message (optional)
TENANT_APPOINTMENT_CONFIRMATION_MESSAGE=Your appointment has been scheduled! A Google Calendar invitation will be sent to you shortly. Thank you for choosing our legal services!
