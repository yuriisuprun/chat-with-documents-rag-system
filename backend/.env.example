DATABASE_URL=postgresql://assistant_user:assistant_password@db:5432/whatsapp_assistant
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=sk-your_openai_api_key_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
JWT_SECRET=your_jwt_secret_change_me_with_random_string
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
MODEL_NAME=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_LENGTH=2000

# SINGLE TENANT CONFIGURATION
TENANT_BUSINESS_NAME=My Professional Services
TENANT_PROFESSIONAL_NAME=John Doe
TENANT_WHATSAPP_NUMBER=+1234567890
TENANT_AUTO_REPLY_DELAY_MINUTES=30
TENANT_BOOKING_URL=https://example.com/booking
TENANT_OFFICE_HOURS=Mon-Fri 9AM-5PM EST
TENANT_DISCLAIMER=This is an automated assistant. This message is not professional advice.

# APPOINTMENT AUTOMATION - GOOGLE CALENDAR INTEGRATION (RECOMMENDED)
# Set to true to enable automatic appointment scheduling
TENANT_ENABLE_AUTO_APPOINTMENT=false

# Calendar Type: "google_calendar" (recommended) or "custom"
# Calendly is no longer supported - use Google Calendar for direct calendar integration
TENANT_APPOINTMENT_API_TYPE=google_calendar

# Google Calendar Service Account Credentials (JSON format) - REQUIRED for google_calendar
# Download from Google Cloud Console as a JSON file and paste the entire JSON here
# Get started: https://console.cloud.google.com → APIs & Services → Credentials → Create Service Account
TENANT_APPOINTMENT_API_KEY={"type":"service_account","project_id":"your_project_id","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# Custom API Endpoint (only needed for api_type="custom")
TENANT_APPOINTMENT_API_URL=

# Appointment Duration in minutes
TENANT_APPOINTMENT_DEFAULT_DURATION=30

# Working Hours Configuration
TENANT_APPOINTMENT_WORKING_HOURS_START=9
TENANT_APPOINTMENT_WORKING_HOURS_END=17

# Custom Confirmation Message (optional)
TENANT_APPOINTMENT_CONFIRMATION_MESSAGE=Your appointment has been scheduled successfully!
